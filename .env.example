# CareAIgent — required environment variables
# Copy this file to .env.local and fill in the values

# Railway PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Your site URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL="https://careaigent.be"

# Resend API key — get from resend.com
RESEND_API_KEY="re_..."

# Initial admin credentials (used by: npm run db:seed)
ADMIN_EMAIL="admin@careaigent.be"
ADMIN_PASSWORD="change-me-in-production"

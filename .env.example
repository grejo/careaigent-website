# CareAIgent — required environment variables
# Copy this file to .env.local and fill in the values

# Railway PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Your site URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL="https://careaigent.be"

# Power Automate webhook voor alle mails (optioneel: kan ook in Admin › Mail,
# de waarde in de databank heeft voorrang)
POWER_AUTOMATE_WEBHOOK_URL=""

# Publieke URL voor links in mails (optioneel; standaard NEXTAUTH_URL)
SITE_URL="https://careaigent.be"

# Initial admin credentials (used by: npm run db:seed)
ADMIN_EMAIL="admin@careaigent.be"
ADMIN_PASSWORD="change-me-in-production"
